# Machine-specific paths for AnnoLoop. Copy to .env (not in git) and adjust.
# Relative paths start at the repo root. Configs use them as ${ANNOLOOP_INPUT} and ${ANNOLOOP_RUNS}.
ANNOLOOP_INPUT=data/input              # raw MACSima images (read only)
ANNOLOOP_RUNS=data/runs                # .zarr stores, one per image
ANNOLOOP_ANNOTATIONS=data/annotations  # the annotators' folders (<annotator>/round_<NN>/<image>/)
ANNOLOOP_MODELS=data/models            # fine-tuned Cellpose models (<name>/)
