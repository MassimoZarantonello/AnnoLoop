# Machine-specific paths for macroseg. Copy to .env (not in git) and adjust.
# Relative paths start at the repo root. Configs use them as ${MACROSEG_INPUT} and ${MACROSEG_RUNS}.
MACROSEG_INPUT=data/input              # raw MACSima images (read only)
MACROSEG_RUNS=data/runs                # .zarr stores written by macroseg.baseline
MACROSEG_ANNOTATIONS=data/annotations  # annotation rounds (round_<NN>/<image>/)
MACROSEG_MODELS=data/models            # fine-tuned Cellpose models (<name>/)
