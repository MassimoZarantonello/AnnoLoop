# Machine-specific paths for macroseg. Copy to .env (not in git) and adjust; relative paths start at the repo root.
# Configs use them as ${MACROSEG_INPUT} and ${MACROSEG_RUNS}.

# --- Mewtwo ---
MACROSEG_INPUT=/srv/data/massimoz/u_csc/private/DATA/MACSima    # raw MACSima images (read only)
MACROSEG_RUNS=/srv/data/massimoz/macroseg_runs                  # .zarr stores written by macroseg.baseline
MACROSEG_ANNOTATIONS=/srv/data/massimoz/macroseg_annotations    # annotation rounds (round_<NN>/<image>/)

# --- Mac: local copies, plus where they come from on Mewtwo (host:path, for rsync) ---
# MACROSEG_INPUT=data/input                  # not used on the Mac (the pipeline runs on Mewtwo)
# MACROSEG_RUNS=data/runs
# MACROSEG_ANNOTATIONS=data/annotations
# MACROSEG_REMOTE_RUNS=cn2031:/srv/data/massimoz/macroseg_runs
# MACROSEG_REMOTE_ANNOTATIONS=cn2031:/srv/data/massimoz/macroseg_annotations
